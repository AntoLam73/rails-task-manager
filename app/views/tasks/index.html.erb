<div class="container mt-4 mb-4 p-4 border rounded-3 bg-light">
  <div class="mb-4">
    <h1>List of tasks</h1>
  </div>

  <div class="mb-4 pb-4 border-bottom">
    <ul>
      <% @tasks.each do |task| %>
        <li>
          <%= link_to task_path(task) do %>
            <%= task.title %> -
            <%= link_to "Delete", task_path(task), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="mt-4">
    <%= link_to "Add new task", new_task_path %>
  </div>
</div>
