
<div class="container mt-4 mb-4 p-4 border rounded-3 bg-light">
  <div class="d-flex flex-column justify-content-center gap-3">
    <%= form_with model: task do |f| %>
      <div class="d-flex flex-column mb-3">
        <%= f.label :title %>
        <%= f.text_field :title %>
      </div>
      <div class="d-flex flex-column mb-3">
        <%= f.label :details %>
        <%= f.text_field :details %>
      </div>
      <div class="d-flex flex-column mb-3 form-check">
        <%= f.label :completed %>
        <%= f.check_box :completed %>
      </div>
      <div class="d-flex flex-column mb-3">
        <%= f.submit %>
      </div>
    <% end %>

    <%= link_to "Back to list", tasks_path %>

  </div>
</div>
