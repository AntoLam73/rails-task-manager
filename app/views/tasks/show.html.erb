<div class="container mt-4 mb-4 p-4 border rounded-3 bg-light">
  <div class="mb-4">
    <h1><%= @task.title %></h1>
    <h3><%= @task.details %></h3>
    <p>Done: <%= @task.completed %></p>
  </div>

  <div class="d-flex gap-5">
    <div class="mb-4">
      <%= link_to "Edit this task", edit_task_path %>
    </div>

    <div class="mb-4">
      <%= link_to "Back to list", tasks_path %>
    </div>

    <div class="mb-4">
      <%= link_to "Delete", task_path(@task), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

</div>
